# Optional OpenAI text-to-speech for clearer, more natural voices.
# Leave blank to use free built-in browser speech (works offline).
# Create a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Friendliest OpenAI voices for kids (no true "child" voice on OpenAI):
#   shimmer, nova, coral, sage
# More unique / character / kid voices need another provider (e.g. ElevenLabs).
OPENAI_TTS_VOICE=shimmer

# gpt-4o-mini-tts supports speaking-style instructions (best for kid-friendly tone)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# How the voice should sound (only used with gpt-4o-mini-tts)
OPENAI_TTS_INSTRUCTIONS=Speak warmly and gently, like a kind preschool teacher talking to a toddler. Soft, clear, cheerful, and unhurried — never robotic or stern.

# Which engine to use in the app:
#   auto    — OpenAI if OPENAI_API_KEY is set, otherwise browser
#   browser — always use free device speech
#   openai  — always use OpenAI (falls back to browser if the call fails)
VITE_TTS_ENGINE=auto
